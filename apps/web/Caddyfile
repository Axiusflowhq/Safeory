:8080 {
  root * /srv
  encode zstd gzip

  header {
    Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' __SAFEORY_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    Referrer-Policy "no-referrer"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  }

  handle_path /api/* {
    reverse_proxy api:8080
  }

  handle {
    try_files {path} /index.html
    file_server
  }
}
